---
import type {SiteSettings} from '../lib/types'

interface Props {
  settings: SiteSettings
}
const {settings} = Astro.props
const nav = settings.headerNav?.length
  ? settings.headerNav
  : [
      {label: 'Services', href: '/services'},
      {label: 'Commercial', href: '/commercial-electrician'},
      {label: 'About', href: '/about-us'},
      {label: 'Our Team', href: '/our-team'},
      {label: 'Blog', href: '/blog'},
      {label: 'FAQ', href: '/faq'},
      {label: 'Careers', href: '/careers'},
    ]
const cta = settings.primaryCta ?? {label: 'Free Estimate', href: '/contact-us'}
const current = Astro.url.pathname.replace(/\/$/, '')
---

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-page flex h-18 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${settings.businessName} home`}>
      <picture>
        <source srcset="/logo.avif" type="image/avif" />
        <img src="/logo.png" alt={settings.businessName} width="64" height="57" class="h-12 w-auto" />
      </picture>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-6 font-display text-[15px] font-medium text-ink">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class:list={['hover:text-brand', current.startsWith(item.href) && 'text-brand']} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${settings.phoneE164}`} class="hidden font-display font-semibold text-ink hover:text-brand sm:inline">{settings.phone}</a>
      <a href={cta.href} class="btn-primary hidden py-2 sm:inline-flex">{cta.label}</a>
      <details class="relative lg:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-line" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-64 rounded-md border border-line bg-white p-4 shadow-lg">
          <ul class="space-y-3 font-display text-ink">
            {nav.map((item) => <li><a href={item.href} class="block hover:text-brand">{item.label}</a></li>)}
            <li><a href={cta.href} class="btn-primary mt-2 w-full">{cta.label}</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

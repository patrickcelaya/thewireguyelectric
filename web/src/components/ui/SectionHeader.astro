---
// A section's head: the eyebrow, the H2 (its accent words take the heading's own
// colour: copper accents are for H1s), and an optional intro with links (slot "more"). "split" puts the intro in a column
// beside the heading (the editorial head); "stack" puts it underneath.
import Eyebrow from './Eyebrow.astro'
import Accent from './Accent.astro'

interface Props {
  heading: string
  /** Words of the heading wrapped as its accent (first occurrence). */
  accent?: string
  id?: string
  eyebrow?: string
  as?: 'h2' | 'h3'
  intro?: string
  layout?: 'split' | 'stack'
  class?: string
}

const {heading, accent, id, eyebrow, as: Tag = 'h2', intro, layout = 'split', class: className} = Astro.props
const hasMore = Astro.slots.has('more')
---

<div class:list={['head', layout === 'stack' && 'head--stack', className]}>
  <div>
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <Tag class="h2" id={id}><Accent text={heading} accent={accent} /></Tag>
  </div>
  {
    (intro || hasMore) && (
      <div class="intro">
        {intro && <p>{intro}</p>}
        {hasMore && (
          <p class="more">
            <slot name="more" />
          </p>
        )}
      </div>
    )
  }
</div>

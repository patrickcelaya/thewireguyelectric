---
// A CMS image from Sanity's image CDN: srcset over `widths` (AVIF/WebP picked by the
// CDN), width and height from the asset (or the crop ratio), lazy by default.
// `priority` is for the one LCP image per page: eager, fetchpriority=high,
// decoding=sync (also add a preload with lib/image's helpers if it sits low in the HTML).
// When a frame crops the photo (object-fit: cover), the editor's hotspot sets what
// stays in view (object-position). Company photos of people carry their head boxes
// (data-faces) for the QA face checks. Renders nothing when the image can't be served.
import type {ImageRef} from '../../lib/types'
import {hasImage, imageAlt, imageDimensions, imageFocus, imageSrcSet, imageUrl} from '../../lib/image'
import {facesInFrame} from '../../lib/brand-photos'

interface Props {
  image: ImageRef | null | undefined
  /** Rendition widths, capped at the image's own width. */
  widths?: number[]
  /** Must match the layout, e.g. "(min-width: 1024px) 384px, 92vw". */
  sizes: string
  /** Crop every rendition to this ratio (width / height). */
  aspect?: number
  /**
   * Alt text; defaults to the image's own, which a thumbnail beside its title or a captioned photo keeps too
   * (docs/DESIGN_SYSTEM.md section 7). Pass "" only for art that shows nothing (the valley relief), a background
   * texture, or a video poster inside its labelled link.
   */
  alt?: string
  priority?: boolean
  class?: string
  style?: string
  /** Head boxes the layout keeps clear ("x0,y0,x1,y1;…"), read by the QA face checks. Defaults to the photo's own (lib/brand-photos), in the frame it is served in. */
  faces?: string
}

const {image, widths = [480, 768, 1080, 1440, 1920], sizes, aspect, alt, priority = false, class: className, style, faces = facesInFrame(image, aspect)} = Astro.props
const ok = hasImage(image)
const own = ok ? imageDimensions(image) : undefined
const width = own?.width
const height = own && (aspect ? Math.round(own.width / aspect) : own.height)
const fallbackWidth = Math.min(own?.width ?? 1080, 1080)
const src = ok ? imageUrl(image, {width: fallbackWidth, height: aspect ? fallbackWidth / aspect : undefined}) : ''
const srcset = ok ? imageSrcSet(image, widths, aspect) : undefined
// a rendition cropped to `aspect` is already framed on the hotspot by the CDN
const focus = ok && !aspect ? imageFocus(image) : undefined
const css = [focus && `object-position:${focus}`, style].filter(Boolean).join(';') || undefined
---

{
  ok && (
    <img
      src={src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      width={width}
      height={height}
      alt={alt ?? imageAlt(image) ?? ''}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      class={className}
      style={css}
      data-faces={faces}
    />
  )
}

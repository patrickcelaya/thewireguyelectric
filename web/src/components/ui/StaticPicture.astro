---
// A committed image (public/img) with AVIF and/or WebP renditions and a fallback.
interface Props {
  src: string
  /** "url 110w, url 220w, …" per format. */
  avif?: string
  webp?: string
  sizes: string
  width: number
  height: number
  alt: string
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high'
  class?: string
}

const {src, avif, webp, sizes, width, height, alt, loading = 'lazy', fetchpriority, class: className} = Astro.props
---

<picture>
  {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
  {webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
  <img
    src={src}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    decoding={loading === 'lazy' ? 'async' : undefined}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>

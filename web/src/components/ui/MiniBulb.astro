---
// The small bulb from the sprite (site/SvgSprite.astro, #mb). On cards it is hidden
// at rest and lights on hover/focus; elsewhere it is a quiet sign-off. Decorative.
interface Props {
  class?: string
}

const {class: className = 'mini-bulb'} = Astro.props
---

<svg class={className} viewBox="-40 -40 380 470" aria-hidden="true" focusable="false"><use href="#mb"></use></svg>

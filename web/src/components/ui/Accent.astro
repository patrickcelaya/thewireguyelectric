---
// A heading's text with its highlighted words wrapped in .accent: copper in an H1, the
// heading's own colour anywhere else (the accent words belong to H1s only). Plain text
// when the words aren't in the heading.
import {accentParts} from '../../lib/format'

interface Props {
  text: string
  accent?: string | null
}

const {text, accent} = Astro.props
const [before, words, after] = accentParts(text, accent)
---

{before}{words && <span class="accent">{words}</span>}{after}

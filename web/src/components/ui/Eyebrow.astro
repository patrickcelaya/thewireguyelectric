---
// The editorial kicker above a heading: an optional section number and hairline,
// the small bulb mark, then the label. Always a <p>, never part of the heading. A label
// in parts ("Family-owned in Mesa, Arizona · Since 2017") sets them as .seps parts, so a
// part that wraps on a phone takes its dot with it instead of leaving it at a line end.
interface Props {
  /** Section number ("06"); numbers are zero-padded. */
  number?: number | string
  variant?: 'pill' | 'cream' | 'sky'
  class?: string
}

const {number, variant, class: className} = Astro.props
const n = typeof number === 'number' ? String(number).padStart(2, '0') : number
const label = await Astro.slots.render('default')
const parts = label.split(' · ').map((p) => p.trim())
---

<p class:list={['kicker', variant && `kicker--${variant}`, className]}>
  {n && <><span class="kicker__n" aria-hidden="true">{n}</span>{' '}</>}
  {
    parts.length > 1 ? (
      <span class="kicker__t">
        <span class="seps">
          {parts.map((p, i) => (
            <>
              {i > 0 && ' '}
              <span set:html={p} />
            </>
          ))}
        </span>
      </span>
    ) : (
      <span class="kicker__t" set:html={label} />
    )
  }
</p>

---
// The label above a heading: words only, in Red Hat Text 600, copper-700 on light
// surfaces (cream on the copper bands). No number, no rule, no bulb mark: sections are
// not a sequence. Always a <p>, never part of the heading. A label in parts
// ("Family-owned in Mesa, Arizona · Since 2017") sets them as .seps parts, so a part
// that wraps on a phone takes its dot with it instead of leaving it at a line end.
interface Props {
  variant?: 'cream'
  class?: string
}

const {variant, class: className} = Astro.props
const label = (await Astro.slots.render('default')).trim()
const parts = label.split(' · ').map((p) => p.trim())
---

{
  label && (
    <p class:list={['kicker', variant && `kicker--${variant}`, className]}>
      {parts.length > 1 ? (
        <span class="seps">
          {parts.map((p, i) => (
            <>
              {i > 0 && ' '}
              <span set:html={p} />
            </>
          ))}
        </span>
      ) : (
        <Fragment set:html={label} />
      )}
    </p>
  )
}

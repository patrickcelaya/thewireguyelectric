---
// "{Service}, the short version" (round-5 Panels mockup): the answer-first line on the
// left, the facts on the right. The service's own "At a glance" facts come first (only
// what the business confirmed, from Sanity); the verifiable standard facts fill the
// grid to four: free estimates, the licence (linked to the ROC lookup) and the office
// hours with Emma's status. No price is ever shown here (owner rule).
// Styles: styles/inner.css (.glance--wide, .facts--grid) and styles/cms.css.
import type {ServiceDoc, SiteSettings} from '../../lib/types'
import {businessSummary, licence, officeHours} from '../../lib/site'
import Eyebrow from '../ui/Eyebrow.astro'
import ExternalLink from '../ui/ExternalLink.astro'
import OfficeStatus from '../ui/OfficeStatus.astro'

interface Props {
  service: ServiceDoc
  settings: SiteSettings
  number?: number
}

const {service, settings, number} = Astro.props
const name = service.heading ?? service.name
const roc = licence(settings)
const hours = officeHours(settings).line
const own = (service.atAGlance ?? []).filter((f) => f.label && f.value)
const standard = [
  {key: 'estimate', label: 'Estimates', value: 'Free, with flat-rate pricing'},
  roc && {key: 'licence', label: 'License', value: 'Licensed, bonded, and insured'},
  hours && {key: 'hours', label: 'Office hours', value: hours},
].filter((f): f is {key: string; label: string; value: string} => Boolean(f))
const facts = [...own.map((f) => ({key: f._key, label: f.label, value: f.value})), ...standard].slice(0, Math.max(4, own.length))
const summary = businessSummary(settings)
---

<section class="section glance-s" aria-labelledby="glance-h">
  <div class="wrap glance glance--wide">
    <div class="glance__copy">
      <Eyebrow number={number}>At a glance</Eyebrow>
      <h2 class="h2" id="glance-h">{name}, the short version</h2>
      {summary && <p class="answer">{summary}</p>}
    </div>
    <dl class="facts facts--grid">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>{' '}
            <dd>
              <b>{f.value}</b>
              {f.key === 'estimate' && <>{' '}No pressure and no obligation.</>}
              {f.key === 'licence' && roc && (
                <>
                  {' '}
                  {roc.href ? <ExternalLink class="link" href={roc.href}>AZ {roc.number}</ExternalLink> : `AZ ${roc.number}`}
                </>
              )}
              {f.key === 'hours' && (
                <>
                  {' '}
                  <OfficeStatus settings={settings} class="facts__status" />
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

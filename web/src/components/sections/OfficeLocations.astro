---
// Office cards (officeLocationsSection): the chosen offices from Site settings, each
// as an <address> card (OfficeCard). The Mesa home address (footerOnly) is never
// shown here; with nothing else to show, the section renders nothing.
// Styles: styles/pages.css "OFFICES".
import type {OfficeLocationsSection, SiteSettings} from '../../lib/types'
import {visibleOffices} from '../../lib/offices'
import SectionHeader from '../ui/SectionHeader.astro'
import OfficeCard from './OfficeCard.astro'

interface Props {
  section: OfficeLocationsSection
  settings: SiteSettings
}

const {section, settings} = Astro.props
const id = `${section._key}-h`
const offices = visibleOffices(section.offices)
const heading = section.heading ?? (offices.length === 1 ? 'Our office' : 'Our offices')
---

{
  offices.length > 0 && (
    <section class="section offices-s" aria-labelledby={id}>
      <div class="wrap">
        <SectionHeader heading={heading} id={id} eyebrow={section.eyebrow} intro={section.intro} />
        <div class="offices">
          {offices.map((office) => (
            <OfficeCard office={office} settings={settings} />
          ))}
        </div>
      </div>
    </section>
  )
}

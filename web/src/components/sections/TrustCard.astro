---
// The glass trust card of the inner heroes: the copper 5.0 with the stars, the review
// count and the Google link, then the licence linked to the ROC lookup. Extra blocks
// (the Scottsdale office) go in the default slot. Values from Site settings only.
// Styles: styles/inner.css (.itrust) and styles/cms.css.
import type {SiteSettings} from '../../lib/types'
import {ratingSummary, siteRating} from '../../lib/site'
import ExternalLink from '../ui/ExternalLink.astro'
import RocLink from '../ui/RocLink.astro'
import Stars from '../ui/Stars.astro'

interface Props {
  settings: SiteSettings
  class?: string
}

const {settings, class: className} = Astro.props
const rating = siteRating(settings)
const extra = Astro.slots.has('default')
---

<div class:list={['itrust', className]}>
  <div class:list={['itrust__card', extra && 'itrust__card--more']}>
    {
      rating && (
        <>
          <p class="itrust__num" aria-hidden="true">
            {rating.value}
          </p>
          <div class="itrust__meta">
            <p class="itrust__rating">
              <Stars />{' '}
              <span>
                <span class="sr-only">Rated {rating.value} out of 5 </span>
                {ratingSummary(rating)}
              </span>
            </p>
            {rating.href && (
              <p>
                <ExternalLink class="link link--ext" href={rating.href}>
                  Read our reviews on {rating.source}
                </ExternalLink>
              </p>
            )}
          </div>
        </>
      )
    }
    <p class="itrust__roc"><RocLink settings={settings} /></p>
    <slot />
  </div>
</div>

---
// Renders a page's section array. The first hero's heading becomes the page H1
// unless the page already renders its own.
import type {PageSection, SiteSettings} from '../../lib/types'
import {getFaqs, getFeaturedReviews, getLocations, getOpenJobs, getPosts, getServices, getTeam} from '../../lib/queries'
import SanityImage from '../SanityImage.astro'
import RichText from '../RichText.astro'
import TrustBar from '../TrustBar.astro'
import ServiceCard from '../ServiceCard.astro'
import PostCard from '../PostCard.astro'
import FaqList from '../FaqList.astro'
import CtaBand from '../CtaBand.astro'
import ContactForm from '../ContactForm.astro'

interface Props {
  sections: PageSection[]
  settings: SiteSettings
  /** True when the page template already rendered an H1. */
  hasH1?: boolean
}

const {sections, settings, hasH1 = false} = Astro.props
const needs = new Set(sections.map((s) => s._type))
const [services, locations, posts, team, reviews, jobs, allFaqs] = await Promise.all([
  needs.has('servicesSection') ? getServices() : [],
  needs.has('locationsSection') ? getLocations() : [],
  needs.has('postsSection') ? getPosts() : [],
  needs.has('teamSection') ? getTeam() : [],
  needs.has('reviewsSection') ? getFeaturedReviews() : [],
  needs.has('jobsSection') ? getOpenJobs() : [],
  needs.has('faqSection') ? getFaqs() : [],
])
let h1Used = hasH1
const takeH1 = () => (h1Used ? false : (h1Used = true))
---

{
  sections.map((s) => {
    switch (s._type) {
      case 'heroSection': {
        const H = takeH1() ? 'h1' : 'h2'
        return (
          <section class="bg-brand-light">
            <div class="container-page grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-24">
              <div>
                {s.eyebrow && <p class="font-display font-semibold uppercase tracking-wide text-brand">{s.eyebrow}</p>}
                <H class="mt-2 text-4xl font-bold leading-tight sm:text-5xl">{s.heading}</H>
                {s.text && <p class="mt-5 text-lg">{s.text}</p>}
                <div class="mt-8 flex flex-wrap gap-3">
                  <a href={s.primaryCta?.href ?? '/contact-us'} class="btn-primary">{s.primaryCta?.label ?? 'Get a free estimate'}</a>
                  {s.showPhone !== false && <a href={`tel:${settings.phoneE164}`} class="btn-outline">Call {settings.phone}</a>}
                </div>
                {s.showTrustBar !== false && <TrustBar settings={settings} class="mt-8" />}
              </div>
              {s.image && <SanityImage image={s.image} width={720} aspect={4 / 3} priority class="aspect-[4/3] w-full rounded-lg object-cover" />}
            </div>
          </section>
        )
      }
      case 'richTextSection':
        return (
          <section class="container-page mt-16 max-w-3xl">
            {s.heading && <h2 class="mb-6 text-3xl font-bold">{s.heading}</h2>}
            <RichText value={s.body} />
          </section>
        )
      case 'mediaTextSection':
        return (
          <section class="container-page mt-16 grid items-center gap-10 lg:grid-cols-2">
            <div class:list={[s.imagePosition === 'left' && 'lg:order-2']}>
              {s.heading && <h2 class="mb-6 text-3xl font-bold">{s.heading}</h2>}
              <RichText value={s.body} />
              {s.cta && <a href={s.cta.href} class="btn-primary mt-6">{s.cta.label}</a>}
            </div>
            <SanityImage image={s.image} width={640} aspect={4 / 3} class="aspect-[4/3] w-full rounded-lg object-cover" />
          </section>
        )
      case 'servicesSection': {
        const list = s.services?.length ? s.services : s.category?.slug ? services.filter((x) => x.category?.slug === s.category.slug) : services
        return (
          <section class="container-page mt-16">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            {s.intro && <p class="mt-3 max-w-2xl">{s.intro}</p>}
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{list.map((x: any) => <ServiceCard service={x} />)}</div>
          </section>
        )
      }
      case 'locationsSection':
        return (
          <section class="container-page mt-16">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            {s.intro && <p class="mt-3 max-w-2xl">{s.intro}</p>}
            <ul class="mt-6 flex flex-wrap gap-3">
              <li><a href="/" class="inline-block rounded-full border border-line px-4 py-2 font-semibold hover:border-brand hover:text-brand">Mesa</a></li>
              {locations.map((l) => <li><a href={`/locations/${l.slug}`} class="inline-block rounded-full border border-line px-4 py-2 font-semibold hover:border-brand hover:text-brand">{l.name}</a></li>)}
            </ul>
          </section>
        )
      case 'reviewsSection': {
        const list = s.reviews?.length ? s.reviews : reviews
        return list.length ? (
          <section id="reviews" class="container-page mt-16">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            <div class="mt-8 grid gap-6 md:grid-cols-3">
              {list.map((r: any) => (
                <figure class="rounded-md border border-line p-6">
                  <p class="text-brand" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</p>
                  <blockquote class="mt-3">{r.text}</blockquote>
                  <figcaption class="mt-4 font-semibold text-ink">{r.authorName}{r.location && <span class="font-normal text-body"> · {r.location}</span>}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        ) : null
      }
      case 'faqSection': {
        const list = s.faqs?.length ? s.faqs : s.topic ? allFaqs.filter((f) => f.topic === s.topic) : allFaqs
        return <FaqList faqs={list} heading={s.heading} />
      }
      case 'teamSection':
        return (
          <section class="container-page mt-16">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            {s.intro && <p class="mt-3 max-w-2xl">{s.intro}</p>}
            <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
              {team.map((m) => (
                <div>
                  <SanityImage image={m.photo} width={320} aspect={1} class="aspect-square w-full rounded-md object-cover" />
                  <h3 class="mt-3 text-lg font-bold">{m.name}</h3>
                  {m.role && <p class="text-sm">{m.role}</p>}
                </div>
              ))}
            </div>
          </section>
        )
      case 'postsSection':
        return (
          <section class="container-page mt-16">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{posts.slice(0, s.limit ?? 3).map((p) => <PostCard post={p} />)}</div>
          </section>
        )
      case 'jobsSection':
        return (
          <section class="container-page mt-16 max-w-3xl">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            {jobs.map((j) => (
              <article class="mt-8">
                <h3 class="text-2xl font-bold">{j.title}</h3>
                <RichText value={j.description} class="mt-4" />
              </article>
            ))}
          </section>
        )
      case 'contactSection':
        return (
          <section class="container-page mt-16 max-w-2xl">
            {s.heading && <h2 class="text-3xl font-bold">{s.heading}</h2>}
            {s.text && <p class="mt-3">{s.text}</p>}
            <div class="mt-8"><ContactForm formType={s.formType} /></div>
          </section>
        )
      case 'ctaSection':
        return <CtaBand settings={settings} heading={s.cta?.heading} text={s.cta?.text} />
      default:
        return null
    }
  })
}

---
// A service's warning signs as a ruled checklist (round-5 Panels mockup): the body's
// own "Signs …" heading sticky on the left with the paragraph that followed the list
// ("More detail here: …"), the signs as rows between hairlines on the right, each led
// by a short copper dash (they are a list, not a sequence: no numbers). The words
// and links are the body's (lib/cms.ts liftSigns), moved out of the article, not copied.
// Styles: styles/inner.css (.signs).
import type {SignsSection} from '../../lib/cms'
import Eyebrow from '../ui/Eyebrow.astro'
import PortableText from '../PortableText.astro'

interface Props {
  signs: SignsSection
}

const {signs} = Astro.props
// each list item renders as a plain paragraph inside its row
const asParagraph = (block: SignsSection['items'][number]) => [{...block, listItem: undefined, level: undefined}]
---

<section class="section signs-s" aria-labelledby="signs-h">
  <div class="wrap signs">
    <div class="signs__head">
      <Eyebrow>Know the warning signs</Eyebrow>
      <h2 class="display" id="signs-h">{signs.heading}</h2>
      {signs.after.length > 0 && <PortableText value={signs.after} class="signs__more" />}
    </div>
    <ul class="signs__list" role="list">
      {
        signs.items.map((item) => (
          <li>
            <PortableText value={asParagraph(item)} class="signs__t" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

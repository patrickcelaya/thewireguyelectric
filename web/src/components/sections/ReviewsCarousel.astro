---
// The homepage showcase: every review, in two lanes drifting in opposite directions
// (scripts/site/reviews.ts). The controls come before the lanes, so the pause is
// reachable before the moving content (WCAG 2.2.2). Without JS or with reduced
// motion the lanes are still rows that scroll sideways; all text is in the HTML.
// Styles: styles/home.css (the lanes, the dialog) on top of core.css.
import type {Review, SiteSettings} from '../../lib/types'
import {ESTIMATE_PATH} from '../../lib/site'
import Eyebrow from '../ui/Eyebrow.astro'
import ScoreBlock from '../ui/ScoreBlock.astro'
import Button from '../ui/Button.astro'
import ReviewCard from './ReviewCard.astro'

interface Props {
  settings: SiteSettings
  reviews: Review[]
  heading?: string
  /** Words of the heading set in copper. */
  accent?: string
  number?: number | string
  id?: string
}

const {settings, reviews, heading = 'Let our reviews speak for themselves', accent = 'speak for themselves', number, id = 'reviews'} = Astro.props
const at = heading.indexOf(accent)
const [lead, accented, rest] = at >= 0 ? [heading.slice(0, at), accent, heading.slice(at + accent.length)] : [heading, '', '']
const laneA = reviews.filter((_, i) => i % 2 === 0)
const laneB = reviews.filter((_, i) => i % 2 === 1)
const icon = {
  pause: 'M9 6v12M15 6v12',
  play: 'M8 5.5v13l10.5-6.5z',
  prev: 'M15 5.5 8.5 12l6.5 6.5',
  next: 'm9 5.5 6.5 6.5L9 18.5',
}
---

{
  reviews.length > 0 && (
    <section class="section reviews" id={id} aria-labelledby={`${id}-h`}>
      <div class="wrap reviews__head">
        <div class="reviews__title">
          <Eyebrow number={number}>Reviews</Eyebrow>
          <h2 class="display" id={`${id}-h`}>
            {lead}
            {accented && <span class="accent">{accented}</span>}
            {rest}
          </h2>
        </div>
        <div class="reviews__score">
          <ScoreBlock settings={settings} />
          <p class="reviews__cta">
            <Button href={ESTIMATE_PATH} icon="go">Get a Free Estimate Now</Button>
          </p>
        </div>
      </div>
      <div class="wrap reviews__bar">
        <p class="reviews__note">
          Real Google reviews, shown word for word, with each reviewer’s name as it appears on Google.
          <span class="sr-only">Every review shown is rated 5 out of 5 stars.</span>
        </p>
        <div class="mq-ctrl" role="group" aria-label="Review carousel">
          <button class="mq-btn" type="button" data-mq-step="-1" aria-label="Previous reviews">
            <svg class="i" aria-hidden="true" viewBox="0 0 24 24"><path d={icon.prev} /></svg>
          </button>
          <button class="mq-toggle" type="button" data-marquee-toggle>
            <svg class="i i--sm ic-pause" aria-hidden="true" viewBox="0 0 24 24"><path d={icon.pause} /></svg>
            <svg class="i i--sm ic-play" aria-hidden="true" viewBox="0 0 24 24"><path d={icon.play} /></svg>
            <span data-label>Pause reviews</span>
          </button>
          <button class="mq-btn" type="button" data-mq-step="1" aria-label="Next reviews">
            <svg class="i" aria-hidden="true" viewBox="0 0 24 24"><path d={icon.next} /></svg>
          </button>
        </div>
      </div>
      <div class="marquee" data-marquee>
        {[laneA, laneB].map((lane, i) => (
          <div class:list={['lane', i === 0 ? 'lane--a' : 'lane--b']} tabindex="0" role="region" aria-label={`Customer reviews, ${i === 0 ? 'first' : 'second'} row (arrow keys move it)`}>
            <div class="belt">
              <ul class="track" role="list">
                {lane.map((r) => (
                  <ReviewCard review={r} />
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

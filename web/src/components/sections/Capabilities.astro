---
// "What we do": the capabilities as a ruled list on paper, beside the heading, the lede
// and a text link to each service category. Each item linked to a service is a row whose
// title is the link (copper with an underline on hover); an item without a service is the
// same row, unlinked; an item that only carries a link ("+ More!") closes the list as a
// text link. A list, not a sequence: no numbers, no arrows. The section's texture photo
// (decorative) is not shown. Styles: styles/sections.css "WHAT WE DO".
import type {FeatureGridSection} from '../../lib/types'
import type {ServiceGroup} from '../../lib/nav'
import {resolveHref} from '../../lib/links'
import {getRedirectMap} from '../../lib/queries'
import {sectionLabel} from '../../lib/sections'
import Eyebrow from '../ui/Eyebrow.astro'
import Accent from '../ui/Accent.astro'
import TextLink from '../ui/TextLink.astro'

interface Props {
  section: FeatureGridSection
  /** The service categories (Residential, Commercial), linked under the lede. */
  categories: ServiceGroup[]
}

const {section, categories} = Astro.props
const redirects = await getRedirectMap()
const id = `${section._key}-h`
const items = section.items.filter((i) => i.title)
const rows = items.filter((i) => i.service || !i.link)
const closers = items.filter((i) => !i.service && i.link)
---

{
  items.length > 0 && (
    <section class="solutions cv" {...sectionLabel(id, section.heading, section.eyebrow)}>
      <div class="wrap solutions__grid">
        <div class="solutions__copy">
          {section.eyebrow && <Eyebrow>{section.eyebrow}</Eyebrow>}
          {section.heading && (
            <h2 class="h2" id={id}>
              <Accent text={section.heading} accent={section.headingAccent} />
            </h2>
          )}
          {section.intro && <p class="solutions__lede">{section.intro}</p>}
          {categories.length > 0 && (
            <p class="solutions__cats">
              {categories.map((c) => (
                <>
                  <TextLink href={c.href}>
                    {c.label} services
                  </TextLink>{' '}
                </>
              ))}
            </p>
          )}
        </div>
        <div class="sol-wrap">
          <ul class="sol" role="list">
            {rows.map((item) => (
              <li>
                {item.service ? (
                  <a href={`/services/${item.service.slug}`}>
                    <h3>{item.title}</h3>
                  </a>
                ) : (
                  <div class="sol__row">
                    <h3>{item.title}</h3>
                  </div>
                )}
              </li>
            ))}
          </ul>
          {closers.map((item) => (
            <p class="sol__more">
              <TextLink href={resolveHref(item.link!.href, redirects)}>
                {item.title}
              </TextLink>
            </p>
          ))}
        </div>
      </div>
    </section>
  )
}

---
// The live templates' "Ready to Schedule Service?" block as a paper card with a hairline
// beside a long-form article: the quiet rating line with its Google link, the template's
// words, the phone (the aside's one big number), the email, the office hours and the
// button (→ /estimate, owner rule). No licence line (the page states it once, in its
// facts) and no address: the home address is never shown here. Values from Site
// settings. The card's line is not a heading: the card sits beside articles, outside
// their outline. Styles: styles/inner.css (.contact-card).
import type {SiteSettings} from '../../lib/types'
import {ESTIMATE_PATH, officeHours, telHref} from '../../lib/site'
import Button from '../ui/Button.astro'
import RatingLine from '../ui/RatingLine.astro'

interface Props {
  settings: SiteSettings
  /** The button's words (the live templates say "Schedule Now"). */
  label?: string
}

const {settings, label = 'Schedule Now'} = Astro.props
const hours = officeHours(settings).prose
---

<div class="contact-card">
  <RatingLine settings={settings} variant="quiet" class="cc-rating" />
  <p class="contact-card__k">{settings.businessName}</p>
  <p class="contact-card__h">Ready to Schedule Service?</p>
  <p class="contact-card__ph"><a class="tnum" href={telHref(settings)}>{settings.phone}</a></p>
  {
    settings.email && (
      <p class="contact-card__mail">
        <a class="link" href={`mailto:${settings.email}`}>
          {settings.email}
        </a>
      </p>
    )
  }
  {hours && <p class="contact-card__hours">{hours}</p>}
  <Button href={ESTIMATE_PATH} size="md">{label}</Button>
</div>

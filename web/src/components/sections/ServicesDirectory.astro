---
// The services directory (servicesSection, layouts "grid" and "grouped"): every
// service once, as a numbered row (the name is the row's one link, the card text
// under it), so /services lists all of them visibly (the live page hid them in tabs)
// and the commercial page links every commercial service. "grouped" sets each
// category apart: its heading beside the list (sticky on wide screens), its intro
// when the category has one, and a link to the category page. Rows carry text only:
// the service records' photos are partly stock, and the owner wants real photos only.
// Styles: styles/pages.css "SERVICES DIRECTORY".
import type {ServiceCard, ServicesSection} from '../../lib/types'
import {ctaHref} from '../../lib/site'
import {getRedirectMap} from '../../lib/queries'
import {sectionLabel} from '../../lib/sections'
import PortableText from '../PortableText.astro'
import SectionHeader from '../ui/SectionHeader.astro'
import Eyebrow from '../ui/Eyebrow.astro'
import TextLink from '../ui/TextLink.astro'
import MiniBulb from '../ui/MiniBulb.astro'

interface Props {
  section: ServicesSection
  number?: number
}

const {section, number} = Astro.props
const redirects = await getRedirectMap()
const id = `${section._key}-h`
const {cta} = section
const groups =
  section.layout === 'grouped' && section.groups?.length
    ? section.groups
    : [{_id: section._key, name: '', slug: '', heading: undefined, description: null, services: section.services}]
const grouped = groups.length > 1 || Boolean(groups[0].name)
// group headings sit one level below the section heading (H2 when the section has none)
const GroupTitle = section.heading ? 'h3' : 'h2'
// each row one level below its group (or the section) heading
const RowTitle = section.heading && grouped ? 'h4' : 'h3'
const pad = (n: number) => String(n).padStart(2, '0')
const rowText = (s: ServiceCard) => s.text ?? s.shortDescription
---

{
  section.services.length > 0 && (
    <section class="section svcdir-s" {...sectionLabel(id, section.heading, section.eyebrow ?? 'Services')}>
      <div class="wrap">
        {section.heading && (
          <SectionHeader heading={section.heading} accent={section.headingAccent} id={id} eyebrow={section.eyebrow} number={number} intro={section.intro}>
            {cta && (
              <TextLink slot="more" href={ctaHref(cta, redirects)}>
                {cta.label}
              </TextLink>
            )}
          </SectionHeader>
        )}
        {groups.map((group) => {
          const gid = `${section._key}-${group.slug || 'all'}-h`
          return (
            <div class:list={['svcdir', grouped && 'svcdir--grouped']} aria-labelledby={grouped ? gid : undefined} role={grouped ? 'group' : undefined}>
              {grouped && (
                <div class="svcdir__head">
                  {!section.heading && group === groups[0] && <Eyebrow number={number}>{section.eyebrow ?? 'Services'}</Eyebrow>}
                  <GroupTitle class="svcdir__h" id={gid}>
                    {group.heading ?? `${group.name} services`}
                  </GroupTitle>
                  {group.description && group.description.length > 0 && <PortableText value={group.description} class="svcdir__intro" />}
                  <p class="svcdir__more">
                    <TextLink href={`/services-categories/${group.slug}`}>
                      {group.name} services overview
                    </TextLink>
                  </p>
                </div>
              )}
              <ol class="svcdir__list" role="list">
                {group.services.map((s, i) => (
                  <li class="svcrow svc-tile">
                    <span class="svcrow__n" aria-hidden="true">
                      {pad(i + 1)}
                    </span>
                    <div class="svcrow__body">
                      <RowTitle class="svcrow__h">
                        <a href={`/services/${s.slug}`}>{s.title}</a>
                      </RowTitle>
                      {rowText(s) && <p class="svcrow__p">{rowText(s)}</p>}
                    </div>
                    <MiniBulb />
                  </li>
                ))}
              </ol>
            </div>
          )
        })}
        {!section.heading && cta && (
          <p class="svcdir__cta">
            <TextLink href={ctaHref(cta, redirects)}>
              {cta.label}
            </TextLink>
          </p>
        )}
      </div>
    </section>
  )
}

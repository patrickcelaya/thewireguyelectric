---
// One guide in the blog archive (PostsIndex): its date, its title (the row's one link)
// and its excerpt, beside a small thumbnail when the route picked one (`post.thumb`: the
// post's own owner-approved image, else a company photo of its subject; lib/cms.ts
// postThumb). The thumbnail repeats what the title says, so its frame is hidden from
// assistive technology (the photo keeps its alt); it loads lazily at its small size, and
// a photo of people is framed on every head. Styles: styles/pages.css "BLOG INDEX".
import type {PostCard} from '../../lib/types'
import {formatDate, isoDate} from '../../lib/format'
import {facesOf} from '../../lib/brand-photos'
import {facesInView} from '../../lib/cms'
import SanityImage from '../ui/SanityImage.astro'

interface Props {
  post: PostCard
  /** The title's heading level, one below the group heading. */
  as: 'h3' | 'h4'
}

const {post, as: Title} = Astro.props
const thumb = post.thumb
const focus = facesInView(facesOf(thumb))
---

<li class:list={['postrow', thumb && 'postrow--thumb']}>
  {
    post.publishedAt && (
      <p class="postrow__d">
        <time datetime={isoDate(post.publishedAt)}>{formatDate(post.publishedAt, 'short')}</time>
      </p>
    )
  }
  <div class="postrow__body">
    <Title class="postrow__h">
      <a href={`/blog-posts/${post.slug}`}>{post.title}</a>
    </Title>
    {post.excerpt && <p class="postrow__ex">{post.excerpt}</p>}
  </div>
  {
    thumb && (
      <div class="postrow__thumb" aria-hidden="true">
        <SanityImage image={thumb} widths={[160, 240, 320, 400]} sizes="(max-width:599px) 96px, (max-width:1099px) 136px, 168px" style={focus && `object-position:${focus}`} />
      </div>
    )
  }
</li>

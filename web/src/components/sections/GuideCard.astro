---
// A blog post as a guide card: a cover (the post's photo under a warm copper tint,
// the topic on a pill, optional big cover words, the small bulb that lights on
// hover), the date, the title (the card's one link, stretched over the card) and
// the excerpt. Without a photo (no unused photo of its subject on the page) the cover
// is plain copper, lit from the corner the bulb sits in. The post's own owner-approved
// image (`own`, blog pages only) shows in its natural colour: no tint and no cover
// words over it. The cover repeats what the card's title says, so it is hidden from
// assistive technology; the photo still carries its alt text. Render inside
// <ul class="guides" role="list">.
import type {PostSummary} from '../../lib/types'
import {formatDate, isoDate} from '../../lib/format'
import {hasImage} from '../../lib/image'
import SanityImage from '../ui/SanityImage.astro'
import MiniBulb from '../ui/MiniBulb.astro'

interface Props {
  post: PostSummary
  /** The topic pill; defaults to the post's category, else "Guide". */
  label?: string
  /** A few words set big on the cover ("Tripping breakers"). */
  coverWords?: string
  /** object-position for the cover photo, e.g. "50% 42%". */
  focus?: string
  as?: 'h2' | 'h3'
  /** The photo is the post's own owner-approved image (lib/cms.ts ownPostImage): natural colour, no cover words. */
  own?: boolean
}

const {post, label = post.category?.name ?? 'Guide', coverWords, focus, as: Title = 'h3', own = false} = Astro.props
const photo = hasImage(post.mainImage)
---

<li class="guide">
  <div class:list={['cover', !photo && 'cover--plain', photo && own && 'cover--own']} aria-hidden="true">
    <SanityImage image={post.mainImage} widths={[420, 640, 900]} aspect={1.6} sizes="(max-width:899px) 92vw, 30vw" style={focus && `object-position:${focus}`} />
    <span class="lab">{label}</span>{' '}
    {coverWords && !(photo && own) && <span class="big">{coverWords}</span>}
    <MiniBulb />
  </div>
  {
    post.publishedAt && (
      <p class="meta">
        <time datetime={isoDate(post.publishedAt)}>{formatDate(post.publishedAt, 'short')}</time>
      </p>
    )
  }
  <Title><a href={`/blog-posts/${post.slug}`}>{post.title}</a></Title>
  {post.excerpt && <p class="ex">{post.excerpt}</p>}
</li>

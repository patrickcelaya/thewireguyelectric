---
// A city page's hero: the words on bone, then the city's own photo of the crew or the
// trucks (lib/cms.ts cityHero: each city has its own, framed so the heads start at 71.5%
// of it) as an edge-to-edge band in natural colour, with nothing on it: no sky tint, no
// scrim, no card. Desktop: the trail; the eyebrow and the H1 (the town in copper) beside
// the lede, the estimate and call buttons; a city with an office of its own (Scottsdale)
// shows that office as a paper card beside the words. Below 1240 px, where the header has
// no utility line, Emma's status and the quiet trust line follow the buttons. The band is
// anchored on the heads (--fy, the top of the highest head, and --r, the photo's height
// over its width), so the crew reaches the first screen; on phones it comes straight
// after the H1, a window centred on the heads (--pc) and wide enough for all of them
// (--pw). The photo is the page's LCP image: the page preloads the same renditions.
// Styles: styles/inner.css (.ihero--city) and styles/cms.css (.ihero--office).
import type {LocationDoc, PostalAddress, SiteSettings} from '../../lib/types'
import type {Crumb} from '../../lib/seo'
import {ESTIMATE_PATH, telHref} from '../../lib/site'
import {imageDimensions, imageUrl} from '../../lib/image'
import {accentParts} from '../../lib/format'
import {cityAccent, cityHero} from '../../lib/cms'
import Breadcrumbs from '../ui/Breadcrumbs.astro'
import Eyebrow from '../ui/Eyebrow.astro'
import Button from '../ui/Button.astro'
import OfficeStatus from '../ui/OfficeStatus.astro'
import TrustLine from './TrustLine.astro'
import OfficeCard from './OfficeCard.astro'

interface Props {
  location: LocationDoc
  /** The page H1 (location.heading, as the page computes it). */
  heading: string
  settings: SiteSettings
  crumbs: Crumb[]
  /** The office whose Google Business Profile lands on this page. */
  office?: PostalAddress
}

const {location, heading, settings, crumbs, office} = Astro.props
const city = location.shortName || location.name
const eyebrow = [location.cityNameForSeo ?? `${city}, AZ`, location.county].filter(Boolean).join(' · ')
const [before, town, after] = accentParts(heading, cityAccent(heading, city))
const hero = cityHero(location)
const photo = hero.image
const size = imageDimensions(photo)
---

<section class:list={['ihero ihero--city', office && 'ihero--office']} aria-labelledby="hero-h">
  <div class="wrap ihero__copy">
    <Breadcrumbs crumbs={crumbs} />
    <div class="ihero__title">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 id="hero-h">{before}{town && <span class="accent">{town}</span>}{after}</h1>
    </div>
    <div class="ihero__aside">
      {location.description && <p class="ihero__lede">{location.description}</p>}
      <div class="btn-row">
        <Button href={ESTIMATE_PATH}>Get a Free Estimate</Button>{' '}
        <Button href={telHref(settings)} variant="ghost" icon="tel"><span class="tnum">Call {settings.phone}</span></Button>
      </div>
      <p class="ihero__status"><OfficeStatus settings={settings} /></p>
      <TrustLine settings={settings} />
    </div>
    {
      office && (
        <OfficeCard
          settings={settings}
          office={office}
          as="p"
          kicker={`Our ${office.addressLocality} office`}
          note={office.appointmentOnly ? 'Office visits by appointment only. We come to you.' : undefined}
          class="ihero__office"
        />
      )
    }
  </div>
  <figure class="ihero__photo" style={`--pc:${hero.center};--pw:${hero.zoom};--r:${hero.ratio};--fy:${hero.top}`}>
    <img
      src={imageUrl(photo, {width: 1086})}
      srcset={hero.srcset}
      sizes={hero.sizes}
      width={size?.width}
      height={size?.height}
      alt={photo.alt}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      data-faces={hero.faces}
    />
  </figure>
</section>

---
// A service page's hero: the words on bone (the trail, the eyebrow, the H1 in ink, the
// short description as the lede, the estimate and call buttons; below 1240 px, where the
// header has no utility line, Emma's status and the quiet trust line too). How the
// service's photo is staged depends on what it is (lib/cms.ts heroStaging):
//   side:  any company photo, a job or the crew, in natural colour in the right 44%,
//          flush to the edge and the stage's full height (a photo of people framed on
//          their faces); on phones it comes first, right under the header, so no face
//          ever sits behind the call bar at the foot of the screen;
//   plain: no company photo (stock is never shown): the line-drawn bulb on the right.
// No tint, scrim or card on the photo. Styles: styles/inner.css (.ihero) and styles/cms.css.
import type {ServiceDoc, SiteSettings} from '../../lib/types'
import type {Crumb} from '../../lib/seo'
import {ESTIMATE_PATH, telHref} from '../../lib/site'
import {facesOf} from '../../lib/brand-photos'
import {SERVICE_HERO_IMAGE, facesFocus, heroStaging} from '../../lib/cms'
import Breadcrumbs from '../ui/Breadcrumbs.astro'
import Eyebrow from '../ui/Eyebrow.astro'
import Button from '../ui/Button.astro'
import Bulb from '../ui/Bulb.astro'
import OfficeStatus from '../ui/OfficeStatus.astro'
import SanityImage from '../ui/SanityImage.astro'
import TrustLine from './TrustLine.astro'

interface Props {
  service: ServiceDoc
  /** The page H1 (service.heading ?? service.name). */
  heading: string
  settings: SiteSettings
  crumbs: Crumb[]
}

const {service, heading, settings, crumbs} = Astro.props
const staging = heroStaging(service.mainImage)
const eyebrow = [service.category && `${service.category.name} service`, 'Mesa and the Phoenix valley'].filter(Boolean).join(' · ')
// a photo of the crew, framed on their faces (a job photo is framed on its hotspot by SanityImage)
const focus = staging === 'side' ? facesFocus(facesOf(service.mainImage)) : undefined
// the longest word's length: on phones the H1 sets small enough for it to fit the line (styles/inner.css)
const longestWord = Math.max(...heading.split(/\s+/).map((word) => word.length))
---

<section class:list={['ihero ihero--service', `ihero--${staging}`]} aria-labelledby="hero-h">
  <div class="ihero__stage" data-bulb-field>
    {
      staging === 'side' && (
        <figure class="ihero__side">
          <SanityImage image={service.mainImage} widths={[...SERVICE_HERO_IMAGE.widths]} sizes={SERVICE_HERO_IMAGE.sizes} style={focus && `object-position:${focus}`} priority />
        </figure>
      )
    }
    <div class="wrap ihero__copy">
      <Breadcrumbs crumbs={crumbs} />
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 id="hero-h" style={`--word:${longestWord}`}>{heading}</h1>
      {service.shortDescription && <p class="ihero__lede">{service.shortDescription}</p>}
      <div class="btn-row">
        <Button href={ESTIMATE_PATH}>Get a Free Estimate</Button>{' '}
        <Button href={telHref(settings)} variant="ghost" icon="tel"><span class="tnum">Call {settings.phone}</span></Button>
      </div>
      <p class="ihero__status"><OfficeStatus settings={settings} /></p>
      <TrustLine settings={settings} />
    </div>
    {staging === 'plain' && <Bulb lead="right" class="ihero__bulb" />}
  </div>
</section>

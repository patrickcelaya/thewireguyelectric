---
// The promise on the copper band: the values in three columns divided by hairlines
// (title, text, a cream text link; a `service` links the title) under the heading. Not
// a sequence, so no numbers; no cards, glass or glow. Styles: styles/sections.css "OUR PROMISE".
import type {FeatureGridSection} from '../../lib/types'
import {ctaHref} from '../../lib/site'
import {getRedirectMap} from '../../lib/queries'
import {sectionLabel} from '../../lib/sections'
import Eyebrow from '../ui/Eyebrow.astro'
import Accent from '../ui/Accent.astro'
import TextLink from '../ui/TextLink.astro'

interface Props {
  section: FeatureGridSection
}

const {section} = Astro.props
const redirects = await getRedirectMap()
const id = `${section._key}-h`
const items = section.items.filter((i) => i.title)
---

{
  items.length > 0 && (
    <section class="vals" {...sectionLabel(id, section.heading, section.eyebrow)}>
      <div class="wrap vals__grid">
        <div class="vals__head">
          {section.eyebrow && <Eyebrow variant="cream">{section.eyebrow}</Eyebrow>}
          {section.heading && (
            <h2 class="h2" id={id}>
              <Accent text={section.heading} accent={section.headingAccent} />
            </h2>
          )}
        </div>
        <ul class="vcards" role="list">
          {items.map((item) => (
            <li class="vcard">
              <h3>{item.service ? <a href={`/services/${item.service.slug}`}>{item.title}</a> : item.title}</h3> {item.text && <p>{item.text}</p>}{' '}
              {item.link && (
                <TextLink class="vcard__go" href={ctaHref(item.link, redirects)} tone="cream">
                  {item.link.label}
                </TextLink>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

---
import type {SiteSettings} from '../lib/types'

interface Props {
  settings: SiteSettings
  heading?: string
  text?: string
}
const {settings, heading = 'Ready to get started?', text = 'Get a free, no-obligation estimate from a licensed Mesa electrician. Flat-rate pricing, no hidden fees.'} = Astro.props
---

<section class="container-page mt-20">
  <div class="rounded-lg bg-brand px-6 py-12 text-center text-white sm:px-12">
    <h2 class="text-3xl font-bold text-white">{heading}</h2>
    <p class="mx-auto mt-3 max-w-2xl text-white/90">{text}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={settings.primaryCta?.href ?? '/contact-us'} class="btn bg-white text-brand hover:bg-brand-light">{settings.primaryCta?.label ?? 'Get a free estimate'}</a>
      <a href={`tel:${settings.phoneE164}`} class="btn border border-white text-white hover:bg-white/10">Call {settings.phone}</a>
    </div>
  </div>
</section>

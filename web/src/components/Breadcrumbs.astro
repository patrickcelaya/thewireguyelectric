---
import type {Crumb} from '../lib/seo'

interface Props {
  crumbs: Crumb[]
}
const {crumbs} = Astro.props
---

<nav aria-label="Breadcrumb" class="container-page pt-6 text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-body">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i < crumbs.length - 1 ? (
            <a href={c.path} class="hover:text-brand hover:underline">{c.name}</a>
          ) : (
            <span aria-current="page" class="text-ink">{c.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

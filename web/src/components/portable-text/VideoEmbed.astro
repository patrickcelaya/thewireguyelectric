---
// Click-to-play YouTube/Vimeo facade: shows a thumbnail and only loads the
// player iframe on click, keeping third-party JS off the critical path.
const {node} = Astro.props as {node: {url: string; title?: string}}
const yt = node.url.match(/(?:youtube\.com\/(?:embed\/|watch\?v=|shorts\/)|youtu\.be\/)([\w-]{11})/)
const vimeo = node.url.match(/vimeo\.com\/(?:video\/)?(\d+)/)
const embed = yt ? `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1` : vimeo ? `https://player.vimeo.com/video/${vimeo[1]}?autoplay=1` : null
const thumb = yt ? `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg` : null
const title = node.title ?? 'Video'
---

{
  embed && (
    <div class="not-prose my-6 aspect-video overflow-hidden rounded-md bg-ink">
      <button type="button" class="video-facade group relative block h-full w-full" data-embed={embed} aria-label={`Play video: ${title}`}>
        {thumb && <img src={thumb} alt="" width="480" height="360" loading="lazy" class="h-full w-full object-cover opacity-80" />}
        <span class="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white group-hover:bg-brand-dark">▶</span>
      </button>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe')
      iframe.src = btn.dataset.embed!
      iframe.title = btn.getAttribute('aria-label') ?? 'Video'
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture'
      iframe.allowFullscreen = true
      iframe.className = 'h-full w-full'
      btn.replaceWith(iframe)
    })
  })
</script>

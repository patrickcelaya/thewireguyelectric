---
const {node} = Astro.props as {node: {caption?: string; hasHeaderRow?: boolean; rows?: Array<{_key: string; cells?: string[]}>}}
const rows = node.rows ?? []
const [head, ...body] = node.hasHeaderRow === false ? [undefined, ...rows] : rows
---

<div class="not-prose my-6 overflow-x-auto">
  <table class="w-full border-collapse text-left text-sm">
    {node.caption && <caption class="mb-2 text-left font-semibold text-ink">{node.caption}</caption>}
    {
      head && (
        <thead>
          <tr>{head.cells?.map((c) => <th scope="col" class="border-b-2 border-brand bg-brand-light px-3 py-2 font-display text-ink">{c}</th>)}</tr>
        </thead>
      )
    }
    <tbody>
      {body.map((r) => r && <tr>{r.cells?.map((c) => <td class="border-b border-line px-3 py-2">{c}</td>)}</tr>)}
    </tbody>
  </table>
</div>

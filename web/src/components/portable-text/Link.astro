---
import type {MarkProps} from 'astro-portabletext/types'

type Props = MarkProps<{href: string; openInNewTab?: boolean}>
const {node} = Astro.props
const href = node.markDef.href ?? '#'
const external = /^https?:\/\//.test(href) && !/^https?:\/\/(www\.)?thewireguyelectric\.com/.test(href)
// Internal links that were saved as absolute URLs become relative paths.
const finalHref = external ? href : href.replace(/^https?:\/\/(www\.)?thewireguyelectric\.com/, '') || '/'
const newTab = node.markDef.openInNewTab || external
---

<a href={finalHref} target={newTab ? '_blank' : undefined} rel={external ? 'noopener' : undefined}><slot /></a>

---
import {PortableText} from 'astro-portabletext'
import type {PortableTextValue} from '../lib/types'
import Link from './portable-text/Link.astro'
import Sup from './portable-text/Sup.astro'
import Sub from './portable-text/Sub.astro'
import Figure from './portable-text/Figure.astro'
import Table from './portable-text/Table.astro'
import VideoEmbed from './portable-text/VideoEmbed.astro'
import CallToAction from './portable-text/CallToAction.astro'

interface Props {
  value?: PortableTextValue | null
  class?: string
}

const {value, class: className} = Astro.props
const components = {
  type: {figure: Figure, table: Table, videoEmbed: VideoEmbed, callToAction: CallToAction},
  mark: {link: Link, sup: Sup, sub: Sub},
}
---

{
  value?.length ? (
    <div class:list={['prose prose-lg max-w-none prose-headings:font-display prose-a:text-brand prose-a:underline-offset-2', className]}>
      <PortableText value={value as never} components={components} />
    </div>
  ) : null
}

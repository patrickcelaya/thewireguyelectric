---
// Every SEO-relevant <head> tag for a page. Canonicals always point at the
// production origin, and non-production builds are noindexed (see lib/seo.ts).
import {SITE_INDEXABLE, SITE_URL, absoluteUrl, type PageMeta} from '../lib/seo'
import {ogCardAlt, ogCardSpec, recordOgCard} from '../lib/og-card'
import type {SiteSettings} from '../lib/types'

interface Props {
  meta: PageMeta
  settings: SiteSettings
}

const {meta, settings} = Astro.props
const canonical = absoluteUrl(meta.path)
const robots = !SITE_INDEXABLE || meta.noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'
// A canonical on a page that asks not to be indexed sends mixed signals; omit it.
const showCanonical = !meta.noIndex
// every share image is 1200×630. A build makes each page its share card (lib/og-card.ts) from the photo ogImageMeta
// picked; the dev server, which draws no cards, shows that photo's rendition (lib/image.ts ogImageUrl) or /og-default.png
const card = ogCardSpec(meta.path, meta.title, settings, meta.ogPhoto, meta.ogCard)
recordOgCard(card)
const ogImage = import.meta.env.PROD ? `${SITE_URL}${card.file}` : (meta.ogImage ?? `${SITE_URL}/og-default.png`)
const ogImageAlt = import.meta.env.PROD ? ogCardAlt(card, settings.businessName) : meta.ogImage ? meta.ogImageAlt : undefined
---

<title>{meta.title}</title>
{meta.description && <meta name="description" content={meta.description} />}
{showCanonical && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />

<meta property="og:type" content={meta.ogType ?? 'website'} />
<meta property="og:site_name" content={settings.businessName} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={meta.title} />
{meta.description && <meta property="og:description" content={meta.description} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
{meta.description && <meta name="twitter:description" content={meta.description} />}
<meta name="twitter:image" content={ogImage} />
{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
{meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
{meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}

{settings.googleSiteVerification && <meta name="google-site-verification" content={settings.googleSiteVerification} />}

{meta.jsonLd?.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}

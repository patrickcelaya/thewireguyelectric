---
// The site footer (round 5): light and rich, the logo large.
//   Top: the logo, the family-owned line, the licence (linked to the ROC lookup),
//     the rating with "Had us out? Leave a Google review" under it (/review, the short
//     link to Google's review form: src/config/redirects.mjs SHORT_LINKS; it leaves the
//     site, so it is an ExternalLink styled like the rating's Google link, and nofollow so
//     crawlers do not walk into Google's sign-in flow), and Get a Free Estimate with the phone.
//   Grid (#footer-nav, the no-JS menu target): contact info (both offices linked to
//     their Google Business Profiles in the live wording, the Scottsdale one with its
//     profile name; phone, email, hours), the residential and commercial services,
//     the service areas, the company links.
//   Family of brands (real logos), BBB and social profiles, © and the site credit.
// The Mesa street address shows here and nowhere else on the page (owner rule).
import type {SiteSettings} from '../../lib/types'
import type {NavModel} from '../../lib/nav'
import {isoDate} from '../../lib/format'
import {ESTIMATE_PATH, footerOffices, officeHours, profiles, sisterBrands, telHref} from '../../lib/site'
import ExternalLink from '../ui/ExternalLink.astro'
import RatingLine from '../ui/RatingLine.astro'
import RocLink from '../ui/RocLink.astro'
import Button from '../ui/Button.astro'
import Logo from './Logo.astro'

interface Props {
  settings: SiteSettings
  nav: NavModel
}

const {settings, nav} = Astro.props
const offices = footerOffices(settings)
const hours = officeHours(settings).footer
const social = profiles(settings)
const sisters = sisterBrands(settings)
// the year in Arizona, which the daily rebuild turns over just after midnight there
const year = isoDate(new Date().toISOString()).slice(0, 4)
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-top">
      <a class="foot-logo" href="/"><Logo lazy sizes="(max-width:720px) 168px, 224px" /></a>
      <div class="foot-claim">
        <p class="foot-say">Family-owned electricians, serving the entire valley.</p>
        <p class="foot-roc"><RocLink settings={settings} separator="." /></p>
        <RatingLine settings={settings} variant="foot" />
        <p class="foot-review"><ExternalLink class="rating__g" href="/review" rel="nofollow noopener">Had us out? Leave a Google review</ExternalLink></p>
      </div>
      <div class="foot-act">
        <Button href={ESTIMATE_PATH}>Get a Free Estimate</Button>{' '}
        <a class="foot-phone tnum" href={telHref(settings)}>{settings.phone}</a>
      </div>
    </div>
    <div class="foot-grid" id="footer-nav">
      <div class="foot-col foot-nap">
        <h2>Our contact info</h2>
        <address>
          {
            offices.length > 0 && (
              <ul class="foot-gbp" role="list">
                {offices.map((o) => (
                  <li>
                    {o.name && <span class="gbp-name">{o.name}</span>}{' '}
                    {o.href ? (
                      <a class="gbp" href={o.href} target="_blank" rel="noopener">
                        {o.text}
                        <span class="sr-only"> (Google Business Profile, opens in a new tab)</span>
                      </a>
                    ) : (
                      <span class="gbp">{o.text}</span>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
          <p>
            <a href={telHref(settings)} class="tnum">{settings.phone}</a>
            {settings.email && (
              <>
                <br />
                <a href={`mailto:${settings.email}`}>{settings.email}</a>
              </>
            )}
          </p>
        </address>
        {
          hours && (
            <p class="sub">
              Our Office Hours
              <br />
              <strong>{hours}</strong>
            </p>
          )
        }
      </div>
      {
        nav.serviceGroups.map((g) => (
          <nav class="foot-col" aria-label={`${g.label} services`}>
            <h2>
              <a href={g.href}>{g.label} services</a>
            </h2>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <nav class="foot-col" aria-label="Service areas">
        <h2>Service areas</h2>
        <ul>{nav.cities.map((c) => <li><a href={c.href}>{c.name}</a></li>)}</ul>
      </nav>
      <nav class="foot-col" aria-label="Company">
        <h2>Company</h2>
        <ul>
          {nav.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={ESTIMATE_PATH}>Free Estimate</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-family">
      {
        sisters.length > 0 && (
          <>
            <h2 class="lab">Our family of brands</h2>
            <ul class="sisters" role="list">
              {sisters.map((s) => (
                <li>
                  <ExternalLink class="sister" href={s.href}>
                    {s.logo ? (
                      <img src={s.logo.src} srcset={s.logo.srcset} sizes="(max-width:720px) 116px, 132px" alt={s.label} width={s.logo.width} height={s.logo.height} loading="lazy" decoding="async" />
                    ) : (
                      s.label
                    )}
                  </ExternalLink>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <div class="badges">
        {social.bbb && <ExternalLink class="bbb" href={social.bbb} rel="nofollow noopener">BBB profile</ExternalLink>}
        {
          social.facebook && (
            <a class="soc" href={social.facebook} target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z" /></svg>
              <span class="sr-only">Facebook (opens in a new tab)</span>
            </a>
          )
        }
        {
          social.instagram && (
            <a class="soc" href={social.instagram} target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /></svg>
              <span class="sr-only">Instagram (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
    <div class="foot-legal">
      <p>© {year} {settings.legalName ?? settings.businessName}. All rights reserved.</p>
      <p>Website by <ExternalLink href="https://celayaventures.com">Celaya Ventures</ExternalLink></p>
    </div>
  </div>
</footer>

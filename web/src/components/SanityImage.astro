---
// Responsive image from Sanity's CDN (AVIF/WebP via auto=format) with explicit
// width/height so it never causes layout shift. Pass `priority` for the LCP image.
import type {ImageRef} from '../lib/types'
import {hasImage, imageDimensions, imageSrcSet, imageUrl} from '../lib/image'

interface Props {
  image?: ImageRef | null
  width: number
  /** width / height. Defaults to the image's own aspect ratio. */
  aspect?: number
  sizes?: string
  class?: string
  priority?: boolean
  alt?: string
}

const {image, width, aspect, sizes = `(min-width: ${width}px) ${width}px, 100vw`, class: className, priority = false, alt} = Astro.props
const show = hasImage(image)
const dims = show ? imageDimensions(image) : undefined
const ratio = aspect ?? (dims ? dims.width / dims.height : 16 / 9)
const height = Math.round(width / ratio)
const widths = [320, 480, 640, 800, 1024, 1280, 1600].filter((w) => w <= width * 2)
---

{
  show && (
    <img
      src={imageUrl(image, {width, height: aspect ? height : undefined})}
      srcset={imageSrcSet(image, widths, aspect)}
      sizes={sizes}
      width={width}
      height={height}
      alt={alt ?? image.alt ?? ''}
      class={className}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      style={image.asset?.metadata?.lqip ? `background-image:url(${image.asset.metadata.lqip});background-size:cover` : undefined}
    />
  )
}

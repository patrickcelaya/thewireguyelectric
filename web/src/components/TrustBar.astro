---
import type {SiteSettings} from '../lib/types'

interface Props {
  settings: SiteSettings
  class?: string
}
const {settings, class: className} = Astro.props
const r = settings.reviewSummary
const since = settings.foundingDate
---

<ul class:list={['flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-ink', className]}>
  {
    r?.ratingValue && r?.reviewCount && (
      <li>
        <a href={r.reviewsUrl ?? '#reviews'} class="hover:underline" rel={r.reviewsUrl ? 'noopener' : undefined}>
          <span class="text-brand" aria-hidden="true">★★★★★</span> {r.ratingValue.toFixed(1)} from {r.reviewCount}+ {r.source ?? 'Google'} reviews
        </a>
      </li>
    )
  }
  {
    settings.rocLicense && (
      <li>
        <a href="https://roc.az.gov/" class="hover:underline" rel="noopener" title="Verify with the Arizona Registrar of Contractors">AZ ROC #{settings.rocLicense}</a>
      </li>
    )
  }
  <li>Licensed, bonded &amp; insured</li>
  {since && <li>Family owned since {since}</li>}
</ul>

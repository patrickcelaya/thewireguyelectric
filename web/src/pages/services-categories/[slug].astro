---
import WebflowLayout from '../../layouts/WebflowLayout.astro'
import {getServiceCategories, getSettings} from '../../lib/queries'
import {renderServiceCategory} from '../../lib/legacy'
import {resolveDescription, resolveOgImage, resolveTitle} from '../../lib/seo'
import {webPageNode} from '../../lib/schema'
import type {ServiceCategoryDoc} from '../../lib/types'

export async function getStaticPaths() {
  return (await getServiceCategories()).map((c) => ({params: {slug: c.slug}, props: {category: c}}))
}

const {category} = Astro.props as {category: ServiceCategoryDoc}
const settings = await getSettings()
const path = `/services-categories/${category.slug}`
const title = resolveTitle(category.seo, `${category.name} Electrician in Mesa, AZ | ${settings.businessName}`)
const description = resolveDescription(
  category.seo,
  `Top-rated ${category.name} electrician services in the Phoenix valley. Licensed, insured, flat-rate pricing. Serving Mesa, Scottsdale, Chandler, and more.`,
)
const crumbs = [{name: 'Home', path: '/'}, {name: 'Services', path: '/services'}, {name: category.name, path}]
---

<WebflowLayout
  meta={{title, description, path, ogImage: resolveOgImage(settings, category.seo?.ogImage), noIndex: category.seo?.noIndex, breadcrumbs: crumbs}}
  schema={[webPageNode({path, title, description, type: 'CollectionPage', breadcrumbs: crumbs})]}
>
  <Fragment set:html={renderServiceCategory(category)} />
</WebflowLayout>

---
// All posts on one page. Webflow paginated with ?f384d0a1_page=N; one list gives
// every post a link from /blog, and the old query URLs canonicalize here.
import WebflowLayout from '../layouts/WebflowLayout.astro'
import {getPage, getPosts, getSettings} from '../lib/queries'
import {legacyPage, renderBlogPage} from '../lib/legacy'
import {resolveDescription, resolveOgImage, resolveTitle} from '../lib/seo'
import {blogNode, webPageNode} from '../lib/schema'

const [settings, page, posts] = await Promise.all([getSettings(), getPage('blog'), getPosts()])
const title = resolveTitle(page?.seo, `Electrical Tips & Guides | ${settings.businessName} Blog`)
const description = resolveDescription(page?.seo, page?.intro)
const crumbs = [{name: 'Home', path: '/'}, {name: 'Blog', path: '/blog'}]
---

<WebflowLayout
  meta={{title, description, path: '/blog', ogImage: resolveOgImage(settings, page?.seo?.ogImage), breadcrumbs: crumbs}}
  schema={[webPageNode({path: '/blog', title, description, type: 'CollectionPage', breadcrumbs: crumbs}), blogNode(settings, posts)]}
>
  <Fragment set:html={renderBlogPage(legacyPage('blog')!, posts)} />
</WebflowLayout>

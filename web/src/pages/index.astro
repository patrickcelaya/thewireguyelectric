---
import WebflowLayout from '../layouts/WebflowLayout.astro'
import {getPage, getSettings} from '../lib/queries'
import {legacyPage} from '../lib/legacy'
import {resolveDescription, resolveOgImage, resolveTitle} from '../lib/seo'
import {webPageNode} from '../lib/schema'

const [settings, page] = await Promise.all([getSettings(), getPage('index')])
const title = resolveTitle(page?.seo, `${settings.businessName} | Licensed Electrician in Mesa, AZ`)
const description = resolveDescription(page?.seo, page?.intro, settings.description)
---

<WebflowLayout
  meta={{title, description, path: '/', ogImage: resolveOgImage(settings, page?.seo?.ogImage), noIndex: page?.seo?.noIndex}}
  schema={[webPageNode({path: '/', title, description})]}
>
  <Fragment set:html={legacyPage('index')} />
</WebflowLayout>

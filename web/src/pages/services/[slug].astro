---
// A service page (round-5 Panels mockup), built from the service document: the hero
// (the crew's own photo beside the words when there is one), the short version (the service's
// confirmed facts, then the standard ones), the warning signs when the body lists them,
// the body verbatim beside the contact card (its job photo halfway down), real reviews (the service's own first),
// questions (the service's, then the ones /faq tags with it, then the three the live
// template carried) with guides, related services, the valley map and the estimate band.
// No prices (owner rule): no price module, no question about price or with a dollar
// figure in its answer, and no price markup.
// The structured data and the share image describe what the page shows: its own photo
// only when the hero shows it, the guides and related services on their cards.
// Title, description, canonical, H1 and crumbs are unchanged from the live site.
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/bundles/page-cms.css'
import ServiceHero from '../../components/sections/ServiceHero.astro'
import ServiceGlance from '../../components/sections/ServiceGlance.astro'
import WarningSigns from '../../components/sections/WarningSigns.astro'
import LongForm from '../../components/sections/LongForm.astro'
import ContactCard from '../../components/sections/ContactCard.astro'
import ReviewsStatic from '../../components/sections/ReviewsStatic.astro'
import AnswersBand from '../../components/sections/AnswersBand.astro'
import ServiceCards from '../../components/sections/ServiceCards.astro'
import Valley from '../../components/sections/Valley.astro'
import CtaBand from '../../components/sections/CtaBand.astro'
import WorkGallery from '../../components/sections/WorkGallery.astro'
import SectionHeader from '../../components/ui/SectionHeader.astro'
import TextLink from '../../components/ui/TextLink.astro'
import {getFaqs, getLocations, getPostIndex, getReviews, getService, getServiceFaqs, getServices, getSettings} from '../../lib/queries'
import {ogImageMeta, resolveDescription, resolveTitle} from '../../lib/seo'
import {faqNode, serviceName, serviceNode, webPageNode} from '../../lib/schema'
import {absoluteUrl} from '../../lib/seo'
import {serviceAreaCities} from '../../lib/cities'
import {imagePreload} from '../../lib/image'
import {SERVICE_HERO_IMAGE, WORK_LAYOUTS, allSupport, ctaBandPhoto, guideCards, heroStaging, liftSigns, markShown, mergeFaqs, photoTiles, pickReviews, serviceFigure, serviceGuides, serviceTopic, serviceWork, withoutPrices, workLayout} from '../../lib/cms'
import {LIBRARY_PHOTOS, jobPhoto, photoId} from '../../lib/brand-photos'
import {inSentence} from '../../lib/format'

export async function getStaticPaths() {
  return (await getServices()).map((s) => ({params: {slug: s.slug}}))
}

const [settings, service] = await Promise.all([getSettings(), getService(Astro.params.slug!)])
if (!service) throw new Error(`service ${Astro.params.slug} not found`)
const [services, locations, allReviews, taggedFaqs, commonFaqs, postIndex] = await Promise.all([
  getServices(),
  getLocations(),
  getReviews(),
  getServiceFaqs(service._id),
  getFaqs('General'),
  getPostIndex(),
])
const path = `/services/${service.slug}`
// Same template Webflow used: "{name} in Mesa, AZ | The Wire Guy"
const title = resolveTitle(service.seo, `${service.name} in Mesa, AZ | The Wire Guy`)
const description = resolveDescription(service.seo, service.shortDescription)
const crumbs = [
  {name: 'Home', path: '/'},
  {name: 'Services', path: '/services'},
  ...(service.category ? [{name: service.category.name, path: `/services-categories/${service.category.slug}`}] : []),
  // the page's H1, as its Service node is named (lib/schema.ts serviceName)
  {name: serviceName(service), path},
]
const heading = service.heading ?? service.name

const {signs, rest: body} = liftSigns(service.body)
const seed = Math.max(0, services.findIndex((s) => s.slug === service.slug))
const {reviews, local} = pickReviews(service.reviews ?? [], allReviews.filter((r) => !r.serviceSlug), seed)
const reviewsIntro =
  local === reviews.length && local > 0
    ? `Google reviews from customers we did ${inSentence(service.name)} work for, shown word for word.`
    : 'Google reviews from customers across the Phoenix valley, shown word for word.'
// the service's own questions first, then the ones /faq tags with it, then the general ones; none with a price
const ownFaqs = [...withoutPrices(service.faqs), ...withoutPrices(taggedFaqs)]
const faqs = mergeFaqs([ownFaqs, withoutPrices(commonFaqs)])
const guidePosts = serviceGuides(service.relatedPosts, service.slug, postIndex)
const related = service.relatedServices ?? []
// every photo shows once on the page: the hero's and the related services' cards, then the article's own second
// photo of the work, the guide covers, the recent work and the estimate band's photo
const staging = heroStaging(service.mainImage)
const shown = markShown(new Set<string>(), staging === 'plain' ? undefined : service.mainImage, ...photoTiles(related, 3).cards.map((s) => s.mainImage))
const figurePhoto = serviceFigure(service.slug, shown)
// the guide covers pick before "Recent work" (which sits above them), so a guide keeps a photo of its own subject
const guides = guideCards(guidePosts, postIndex, services, seed, shown)
// "Recent work" after the article: two layouts, alternating by service, so neighbouring services differ
const layout = workLayout(service.slug, ['row', 'lead'])
const work = serviceWork(service.slug, jobPhoto(service.mainImage)?.subject, shown, WORK_LAYOUTS[layout])
const ctaPhoto = ctaBandPhoto(path, shown)
// headings name the service where what they head is about it: questions it has its own of, guides that all support it
const topic = serviceTopic(service)
const faqHeading = ownFaqs.length ? `Questions about ${topic}` : 'Questions, answered'
const guidesHeading = allSupport(guidePosts, service.slug, postIndex) ? `Guides on ${topic}` : 'Guides from our blog'
const cities = serviceAreaCities(settings.homeCity, locations)

const hero = staging === 'plain' ? undefined : SERVICE_HERO_IMAGE
// the photo the hero shows (a company photo); a stock image the page hides is never its image or preview
const ownPhoto = hero ? service.mainImage : undefined
// A second photo of the service's work halfway down the article (never the hero's): it keeps its alt (the full
// description) and its caption says it is our work in a few words (the library's short caption, the alt's first clause)
const figureCaption = figurePhoto && (LIBRARY_PHOTOS.find((p) => p.id === photoId(figurePhoto))?.caption ?? figurePhoto.alt)
// after "Our work:" the caption runs on in lower case, but an acronym or a brand keeps its capitals (LED, Tesla, Siemens)
const runOn = (text: string) => (/^([A-Z]{2,}|Tesla|Siemens|Wire Guy)\b/.test(text) ? text : text.charAt(0).toLowerCase() + text.slice(1))
const inlineFigure = figurePhoto?.alt && figureCaption ? {...figurePhoto, caption: `Our work: ${runOn(figureCaption).replace(/\.$/, '')}.`} : undefined
const preload = hero && imagePreload(service.mainImage, [...hero.widths], hero.sizes)
const serviceId = `${absoluteUrl(path)}#service`
---

<SiteLayout
  meta={{title, description, path, ...ogImageMeta(settings, service.seo?.ogImage, ownPhoto), noIndex: service.seo?.noIndex, breadcrumbs: crumbs}}
  schema={[
    {...webPageNode({path, title, description, breadcrumbs: crumbs}), mainEntity: {'@id': serviceId}},
    serviceNode(service, settings, description, {image: ownPhoto, related, guides: guidePosts}),
    faqNode(path, faqs),
  ]}
  bodyClass="inner"
>
  <Fragment slot="head">
    {preload && <link rel="preload" as="image" imagesrcset={preload.imagesrcset} imagesizes={preload.imagesizes} fetchpriority="high" />}
  </Fragment>

  <ServiceHero service={service} heading={heading} settings={settings} crumbs={crumbs} />
  <ServiceGlance service={service} settings={settings} />
  {signs && <WarningSigns signs={signs} />}

  {/* a body without an H2 is named apart from the hero (which the H1 names), so landmark names stay unique */}
  <LongForm body={body} label={`${heading}, in detail`} variant="service" figure={inlineFigure}>
    <ContactCard slot="aside" settings={settings} />
  </LongForm>

  <WorkGallery photos={work} layout={layout} heading="Recent work by our crew" intro="Our own photos of the crew and their work." id="work-h" />

  <ReviewsStatic settings={settings} reviews={reviews} heading="What our customers say" intro={reviewsIntro} />

  <AnswersBand
    faqs={faqs}
    faqHeading={faqHeading}
    faqIntro="From our FAQ."
    posts={guides}
    guidesHeading={guidesHeading}
    guidesIntro="Read up on the details before you call."
  />

  {
    related.length > 0 && (
      <section class="section isvc cv" aria-labelledby="rel-h">
        <div class="wrap">
          <SectionHeader eyebrow="Related services" heading={service.category ? `More ${service.category.name.toLowerCase()} electrical services` : 'More electrical services'} id="rel-h">
            <Fragment slot="more">
              <TextLink href={service.category ? `/services-categories/${service.category.slug}` : '/services'}>
                {service.category ? `All ${service.category.name.toLowerCase()} services` : 'View All Services'}
              </TextLink>
              {service.category?.slug === 'commercial' && (
                <>
                  {' '}
                  <TextLink href="/commercial-electrician">
                    Commercial electricians
                  </TextLink>
                </>
              )}
            </Fragment>
          </SectionHeader>
          <ServiceCards services={related} maxCards={3} />
        </div>
      </section>
    )
  }

  <Valley settings={settings} cities={cities} variant="inner" heading={`${heading} across the valley`} />

  <CtaBand settings={settings} photo={ctaPhoto} />
</SiteLayout>

---
// A city page (round-5 Gilbert mockup), built from the location document: the hero on
// the sky above the fleet, the city at a glance (sourced local facts, permit and power
// notes), the services featured for the city, the city's own long-form copy beside the
// contact card, real reviews (the city's own first), questions and guides, the valley
// map with the other cities, and the estimate band. Every block passes the swap test:
// what differs between cities comes from each city's data, and shared copy (reviews,
// questions) is labelled as shared. Scottsdale is the landing page of its own Google
// Business Profile: its office shows in the hero and as a branch entity.
// Title, description, canonical, H1 and crumbs are unchanged from the live site.
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/inner.css'
import '../../styles/cms.css'
import LocationHero from '../../components/sections/LocationHero.astro'
import LocationGlance from '../../components/sections/LocationGlance.astro'
import ServiceCards from '../../components/sections/ServiceCards.astro'
import LongForm from '../../components/sections/LongForm.astro'
import ContactCard from '../../components/sections/ContactCard.astro'
import ReviewsStatic from '../../components/sections/ReviewsStatic.astro'
import AnswersBand from '../../components/sections/AnswersBand.astro'
import Valley from '../../components/sections/Valley.astro'
import CtaBand from '../../components/sections/CtaBand.astro'
import SectionHeader from '../../components/ui/SectionHeader.astro'
import TextLink from '../../components/ui/TextLink.astro'
import {getFaqs, getLocations, getPostIndex, getReviews, getServices, getSettings} from '../../lib/queries'
import {resolveDescription, resolveOgImage, resolveTitle} from '../../lib/seo'
import {branchFor, branchNode, faqNode, locationServiceNode, webPageNode} from '../../lib/schema'
import {CITY_ORDER, serviceAreaCities} from '../../lib/cities'
import {FLEET_HERO, cityGuides, guideCards, listOf, mergeFaqs, pickReviews} from '../../lib/cms'
import type {LocationDoc} from '../../lib/types'

export async function getStaticPaths() {
  return (await getLocations()).map((l) => ({params: {slug: l.slug}, props: {location: l}}))
}

const {location} = Astro.props as {location: LocationDoc}
const [settings, locations, services, allReviews, commonFaqs, postIndex] = await Promise.all([
  getSettings(),
  getLocations(),
  getServices(),
  getReviews(),
  getFaqs('General'),
  getPostIndex(),
])
const path = `/locations/${location.slug}`
// Same template Webflow used: "Electrician in {City Name for SEO} | The Wire Guy Electric"
const title = resolveTitle(location.seo, `Electrician in ${location.cityNameForSeo ?? `${location.name}, AZ`} | ${settings.businessName}`)
const description = resolveDescription(location.seo, location.description)
const crumbs = [{name: 'Home', path: '/'}, {name: location.name, path}]
const heading = location.heading ?? `Licensed Electrician in ${location.name}, Arizona`
const office = branchFor(settings, location.slug)
const city = location.shortName || location.name

// The services featured for the city, else the residential services in site order.
const featured = location.featuredServices?.length ? location.featuredServices : services.filter((s) => s.category?.slug === 'residential').slice(0, 6)
// Reviews: the city's own first, then real reviews from across the valley (a different set on each city page).
const seed = Math.max(0, CITY_ORDER.indexOf(location.slug))
const {reviews, local} = pickReviews(
  location.reviews ?? [],
  allReviews.filter((r) => !r.locationSlug),
  seed,
)
const reviewsIntro = local
  ? `Google reviews from ${city} customers and others across the Phoenix valley, shown word for word.`
  : 'Google reviews from customers across the Phoenix valley, shown word for word.'
const faqs = mergeFaqs([location.faqs, commonFaqs])
const guides = guideCards(
  cityGuides(city, featured.map((s) => s.slug), postIndex),
  postIndex,
  services,
  seed,
)
const cities = serviceAreaCities(settings.homeCity, locations)
const nearby = (location.nearbyLocations ?? []).map((l) => l.shortName || l.name)

// the office's own entity (its Google Business Profile as the map), which this page is about
const branch: Record<string, unknown> | undefined = office && {...branchNode(settings, office), hasMap: office.googleMapsUrl}
---

<SiteLayout
  meta={{title, description, path, ogImage: resolveOgImage(settings, location.seo?.ogImage, location.mainImage), noIndex: location.seo?.noIndex, breadcrumbs: crumbs}}
  schema={[
    {...webPageNode({path, title, description, breadcrumbs: crumbs}), ...(branch && {about: {'@id': branch['@id']}})},
    locationServiceNode(location),
    branch,
    faqNode(path, faqs),
  ]}
  bodyClass="inner"
>
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={FLEET_HERO.srcset} imagesizes={FLEET_HERO.sizes} fetchpriority="high" />
  </Fragment>

  <LocationHero location={location} heading={heading} settings={settings} crumbs={crumbs} office={office} />
  <LocationGlance location={location} settings={settings} number={1} office={office} />

  {
    featured.length > 0 && (
      <section class="section isvc cv" aria-labelledby="svc-h">
        <div class="wrap">
          <SectionHeader eyebrow="Services" number={2} heading={`Electrical services in ${city}`} id="svc-h">
            <TextLink slot="more" href="/services" icon="go">
              View All Services
            </TextLink>
          </SectionHeader>
          <ServiceCards services={featured} />
        </div>
      </section>
    )
  }

  <LongForm body={location.body} label={`Electrician in ${city}`} variant="city">
    <ContactCard slot="aside" settings={settings} />
  </LongForm>

  {/* the live template's heading; a non-breaking hyphen keeps "5-Star" on one line */}
  <ReviewsStatic settings={settings} reviews={reviews} heading={'Hundreds of 5\u2011Star Reviews'} intro={reviewsIntro} number={3} />

  <AnswersBand
    faqs={faqs}
    faqHeading={location.faqs?.length ? `${city} electrical questions` : 'Questions, answered'}
    faqIntro="Straight answers from the electricians who do the work."
    posts={guides}
    guidesHeading="Guides from our blog"
    guidesIntro="Plain-English answers to the questions Arizona homeowners ask us most."
    numbers={{faq: 4, guides: 5}}
  />

  <Valley
    settings={settings}
    cities={cities}
    variant="inner"
    current={location.slug}
    heading="Other areas we serve"
    intro={nearby.length ? `Near ${city}: ${listOf(nearby)}.` : undefined}
    number={6}
  />

  <CtaBand settings={settings} number={7} />
</SiteLayout>

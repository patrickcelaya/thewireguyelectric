---
// Page shell for the ported Webflow design: Webflow's compiled CSS, the original
// navbar and footer, self-hosted fonts, and webflow-lite in place of Webflow's runtime.
import '@fontsource/lato/300.css'
import '@fontsource/lato/400.css'
import '@fontsource/lato/400-italic.css'
import '@fontsource/lato/700.css'
import '@fontsource/lato/900.css'
import '@fontsource/schibsted-grotesk/400.css'
import '@fontsource/schibsted-grotesk/500.css'
import '@fontsource/schibsted-grotesk/600.css'
import '@fontsource/schibsted-grotesk/700.css'
import Seo from '../components/Seo.astro'
import {getLocations, getServices, getSettings} from '../lib/queries'
import {renderFooter, renderNavbar} from '../lib/legacy'
import {businessNode, breadcrumbNode, graph, websiteNode} from '../lib/schema'
import type {PageMeta} from '../lib/seo'

interface Props {
  meta: PageMeta
  /** Extra JSON-LD nodes for this page (merged into one @graph with the business entity). */
  schema?: Array<Record<string, unknown> | undefined | false>
}

const {meta, schema = []} = Astro.props
const [settings, services, locations] = await Promise.all([getSettings(), getServices(), getLocations()])
const ld = graph([
  businessNode(settings, services),
  websiteNode(settings),
  ...schema.filter((n): n is Record<string, unknown> => Boolean(n)),
  meta.breadcrumbs?.length ? breadcrumbNode(meta.path, meta.breadcrumbs) : undefined,
])
const navbar = renderNavbar(meta.path, locations)
const footer = renderFooter(meta.path)
const ga = settings.ga4MeasurementId
---

<!doctype html>
<html lang="en" class="w-mod-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo meta={{...meta, jsonLd: [ld, ...(meta.jsonLd ?? [])]}} settings={settings} />
    <link rel="stylesheet" href="/wf/css/site.css" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#aa502e" />
    <script is:inline>document.documentElement.classList.add('wf-js')</script>
    <style is:global>
      html.wf-js [data-reveal] { opacity: 0; transform: translate3d(0, 32px, 0); transition: opacity 0.8s ease, transform 0.8s ease; }
      html.wf-js [data-reveal].is-revealed { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        html.wf-js [data-reveal] { opacity: 1; transform: none; transition: none; }
      }
      /* Start states that Webflow's interactions script applied on load. */
      .underline { transition: width 0.3s ease; }
      .nav-text-link .underline, .nav-item-with-line-block .underline, .footer-text-link .underline { width: 0; }
      .nav-text-link:hover .underline, .nav-text-link.w--current .underline, .nav-dropdown:hover .nav-item-with-line-block .underline,
      .icon-link:hover .underline, .footer-text-link:hover .underline { width: 100% !important; }
      .span-name, .span-name-2 { opacity: 0; transform: translateY(6px); transition: opacity 0.2s ease, transform 0.2s ease; pointer-events: none; }
      .span-avatar:hover .span-name, .span-avatar:focus-visible .span-name, .span-avatar:hover .span-name-2 { opacity: 1; transform: none; }
      .accordion-list:not(.w--open), .accordion-list-2:not(.w--open) { display: none; }
      @media screen and (max-width: 991px) {
        .nav-dropdown-list:not(.w--open) { display: none; }
      }
      .accordion-icon, .accordion-icon-2 { transition: transform 0.2s ease; }
      .w--open > .accordion-icon, .w--open > .accordion-icon-2 { transform: rotate(180deg); }
    </style>
    {
      ga && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} />
          <script is:inline define:vars={{ga}}>
            window.dataLayer = window.dataLayer || []
            function gtag() {
              dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', ga)
          </script>
        </>
      )
    }
  </head>
  <body>
    <Fragment set:html={navbar} />
    <slot />
    <Fragment set:html={footer} />
    <script>
      import '../scripts/webflow-lite'
    </script>
  </body>
</html>

# Sanity project the site reads from. Leave empty to build from the local
# Webflow export (migration/sanity-import/production.ndjson).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Optional read token (only needed for a private dataset).
SANITY_API_READ_TOKEN=
# Form delivery (/api/contact). Configure at least one:
FORMSPARK_FORM_ID=
# e.g. a Zapier/Make catch hook that creates the lead in Housecall Pro
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
# Set to "true" only on the production deployment. Anything else renders noindex.
# Set it explicitly in Vercel → Settings → Environment Variables (Production only) at cutover.
SITE_INDEXABLE=
